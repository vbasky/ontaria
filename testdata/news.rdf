<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:news="http://example.org/news#"
    xml:base="http://example.org/news">
  <owl:Ontology rdf:about="http://example.org/news">
    <rdfs:label>News</rdfs:label>
  </owl:Ontology>

  <owl:Class rdf:about="http://example.org/news#NewsItem">
    <rdfs:label>News item</rdfs:label>
    <rdfs:comment>A single editorial item published as news.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/news#headline"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/news#Topic">
    <rdfs:label>Topic</rdfs:label>
    <rdfs:comment>A subject a news item is about.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://example.org/news#headline">
    <rdfs:label>headline</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/news#NewsItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/news#body">
    <rdfs:label>body</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/news#NewsItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/news#published">
    <rdfs:label>published</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/news#NewsItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="http://example.org/news#about">
    <rdfs:label>about</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/news#NewsItem"/>
    <rdfs:range rdf:resource="http://example.org/news#Topic"/>
  </owl:ObjectProperty>

  <news:NewsItem rdf:about="http://example.org/news#item-1001">
    <rdfs:label>Dock strike delays grain shipments</rdfs:label>
    <news:headline>Dock strike delays grain shipments</news:headline>
    <news:body>Port workers at the grain terminal walked out before dawn, holding three bulk carriers that were due to sail on the morning tide.</news:body>
    <news:published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-13T06:30:00Z</news:published>
    <news:about rdf:resource="http://example.org/news#topic-ports"/>
  </news:NewsItem>

  <news:Topic rdf:about="http://example.org/news#topic-ports">
    <rdfs:label>Ports</rdfs:label>
  </news:Topic>
</rdf:RDF>
